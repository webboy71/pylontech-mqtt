[Unit]
Description=Pylontech US2000 Battery to Home Assistant MQTT Gateway
Documentation=https://github.com/
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout

# Working directory where package is installed
WorkingDirectory=/opt/pylontech-mqtt

# Command to execute using dedicated virtual environment
ExecStart=/opt/pylontech-mqtt/venv/bin/python3 -m pylontech_mqtt.main --config /etc/pylontech-mqtt/config.yaml

# Restart automatically on crash or connection failure after 10 seconds
Restart=always
RestartSec=10s

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pylontech-mqtt

# Security sandbox settings
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
